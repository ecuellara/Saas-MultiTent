# Plantilla del entorno del stack de staging (SÍ se versiona).
# Copiar a `.env.staging` (ignorado por git) y rellenar los 4 secretos.
# Este archivo NUNCA lleva secretos: si falta uno, el compose o la API fallan.
#
# OJO: este archivo se pasa de DOS formas (ver compose.staging.yml):
#   1. `docker compose --env-file .env.staging ...` (interpolación de ${...}),
#   2. `env_file:` de los servicios (variables dentro de los contenedores).
# NO pongas aquí `DATABASE_URL`: cada servicio la compone con el host que le
# toca (`db` dentro del compose, `127.0.0.1` fuera).

# --- Red y puertos (defectos fuera del rango de desarrollo) ---
# Desarrollo usa: pg 5433, api 3000, vite 5173, smoke 3100.
STAGING_POSTGRES_PORT=5434
STAGING_API_PORT=3001
STAGING_WEB_PORT=8080

# --- Base de datos del staging (propia, no la de desarrollo) ---
STAGING_DB_USER=postgres
# SECRETO (sin valor por defecto): usa solo caracteres seguros para URL
# (letras, dígitos, guion, guion bajo). Va DENTRO de DATABASE_URL.
STAGING_DB_PASSWORD=
STAGING_DB_NAME=dental_saas_staging

# --- API ---
# SECRETO: la API se niega a arrancar en producción sin él o si es corto.
JWT_SECRET=
# Un solo nginx delante en este compose (en producción con CDN es 2).
TRUST_PROXY=1
# Orígenes CORS (el frontend sale por el mismo proxy; déjalo vacío o quítalo).
FRONTEND_URL=
# Rutas DENTRO de los contenedores (volúmenes nombrados del compose).
UPLOADS_DIR=/app/uploads
BACKUP_DIR=/app/backups
BACKUP_RETENCION_DIAS=14

# --- Seed inicial de plataforma (solo `herramientas npm run db:seed`) ---
# SECRETOS (mín. 12 caracteres, sin valor por defecto en el código).
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
# --- Clínica de demostración (solo `herramientas npm run db:seed-demo`) ---
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
