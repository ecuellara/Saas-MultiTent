# Copiar a .env (nunca versionar el .env real)
# Base de datos (Supabase en prod, Docker en local)
DATABASE_URL="postgresql://user:pass@localhost:5432/dental_saas"
# JWT para access tokens (mín. 32 caracteres)
JWT_SECRET="cambiar-por-secreto-de-al-menos-32-caracteres"
# Owner de plataforma (seed inicial, mín. 12 caracteres)
PLATFORM_OWNER_EMAIL="owner@tu-dominio.pe"
PLATFORM_OWNER_PASSWORD="cambiar-por-clave-segura-12-plus"
# Webhooks de facturación (Fase 8)
BILLING_HMAC_SECRET=""
BILLING_MP_SECRET=""
# App
PORT=3000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
