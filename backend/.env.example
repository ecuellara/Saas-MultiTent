# Plantilla de variables de entorno del backend (sí se versiona).
# Copiar a `.env` y rellenar. Lo que exige cada una:
#
# DATABASE_URL  (obligatoria)  Conexión PostgreSQL. En local, el contenedor de
#                              pruebas sirve: postgresql://postgres:test@127.0.0.1:5433/<base>
# JWT_SECRET    (obligatoria en producción)  Firma de los access tokens.
#                              En producción el arranque FALLA si falta o es corta.
#                              En desarrollo, si no se define, se genera uno
#                              aleatorio por arranque (las sesiones no sobreviven
#                              a un reinicio, pero no hay secreto en disco).
# PORT          (opcional, 3000)
# FRONTEND_URL  (recomendada)  Orígenes permitidos por CORS, separados por comas.
#                              Si está vacía, CORS queda DESACTIVADO.
#
# Credenciales de los seeds (sin valores por defecto en el código, a propósito):
# PLATFORM_OWNER_EMAIL / PLATFORM_OWNER_PASSWORD   -> `npm run db:seed` (panel de plataforma)
# DEMO_OWNER_EMAIL     / DEMO_OWNER_PASSWORD       -> `npm run db:seed-demo` (clínica de demostración)
#
# Firma de webhooks de pago (cuando se integre la pasarela, ver docs/deuda-tecnica.md)
# BILLING_HMAC_SECRET / BILLING_MP_SECRET

DATABASE_URL="postgresql://postgres:test@127.0.0.1:5433/dental_saas_dev?sslmode=disable"
JWT_SECRET=""
PORT=3000
FRONTEND_URL="http://localhost:5173"

PLATFORM_OWNER_EMAIL=""
PLATFORM_OWNER_PASSWORD=""
DEMO_OWNER_EMAIL=""
DEMO_OWNER_PASSWORD=""
