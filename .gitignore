# Monorepo dental SaaS: backend (NestJS) + docs + CI.
# El backend tiene su propio .gitignore; aquí van patrones de raíz.

# Dependencias y build (cinturón y tirantes)
**/node_modules/
**/.vercel/
**/dist/
**/build/
**/*.tsbuildinfo

# Entorno y secretos (nunca al repo)
**/.env
**/.env.*
!**/.env.example
!**/.env.staging.example

# Tests / logs / backups locales
**/coverage/
*.log
*.dump
*.manifiesto.json

# Uploads y storage de desarrollo (solo directorios de datos en raíz)
# (anclados a raíz: un módulo llamado igual en src/ sí se versiona)
/backend/uploads/
/backend/storage/
/storage/

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
